<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZarobitokApp.MainPage"
             Title="Заробіток"
             BackgroundColor="#0B0B12">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- ЖИВИЙ ЛІЧИЛЬНИК -->
            <Border BackgroundColor="#12121A"
                    StrokeThickness="1"
                    Stroke="#22FFFFFF"
                    Padding="22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="AmountLabel"
                           Text="0.00 ₴"
                           FontSize="46"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />

                    <Label x:Name="PerSecondLabel"
                           Text="+0.0000 ₴/сек"
                           FontSize="13"
                           TextColor="#6B7280"
                           HorizontalOptions="Center" />

                    <ProgressBar x:Name="ShiftProgress"
                                 Progress="0"
                                 ProgressColor="#4ADE80"
                                 Margin="0,10,0,4" />

                    <Label x:Name="ElapsedLabel"
                           Text="Зміна не активна"
                           FontSize="15"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="ToggleButton"
                    Text="Почати зміну"
                    FontSize="17"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="16"
                    BackgroundColor="#4ADE80"
                    TextColor="#06210F"
                    Clicked="OnToggleClicked" />

            <!-- НАЛАШТУВАННЯ -->
            <Label Text="НАЛАШТУВАННЯ ЗМІНИ"
                   FontSize="12"
                   TextColor="#6B7280"
                   Margin="4,8,0,0" />

            <Border BackgroundColor="#12121A" StrokeThickness="1"
                    Stroke="#22FFFFFF" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Ставка за годину" FontSize="13" TextColor="#9CA3AF" />
                        <Entry x:Name="RateEntry"
                               Keyboard="Numeric"
                               TextColor="White"
                               BackgroundColor="#1C1C26"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Валюта" FontSize="13" TextColor="#9CA3AF" />
                        <Entry x:Name="CurrencyEntry"
                               MaxLength="4"
                               TextColor="White"
                               BackgroundColor="#1C1C26"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Планова тривалість, год" FontSize="13" TextColor="#9CA3AF" />
                        <Entry x:Name="PlannedEntry"
                               Keyboard="Numeric"
                               TextColor="White"
                               BackgroundColor="#1C1C26"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Неоплачувана перерва, хв" FontSize="13" TextColor="#9CA3AF" />
                        <Entry x:Name="BreakEntry"
                               Keyboard="Numeric"
                               TextColor="White"
                               BackgroundColor="#1C1C26"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Коефіцієнт понаднормових" FontSize="13" TextColor="#9CA3AF" />
                        <Entry x:Name="OvertimeEntry"
                               Keyboard="Numeric"
                               Placeholder="1.0 — без доплати"
                               TextColor="White"
                               BackgroundColor="#1C1C26"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ЖУРНАЛ -->
            <Label Text="ОСТАННІ ЗМІНИ"
                   FontSize="12"
                   TextColor="#6B7280"
                   Margin="4,8,0,0" />

            <CollectionView x:Name="HistoryView" HeightRequest="260">
                <CollectionView.EmptyView>
                    <Label Text="Поки порожньо"
                           TextColor="#4B5563"
                           HorizontalOptions="Center"
                           Margin="0,24" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding DateText}" TextColor="White" FontSize="15" />
                                <Label Text="{Binding DetailText}" TextColor="#6B7280" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding AmountText}"
                                   TextColor="#4ADE80"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
