<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="start_shift"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_start_short"
        android:shortcutLongLabel="@string/shortcut_start_long">
        <intent
            android:action="com.zarobitok.action.START_SHIFT"
            android:targetPackage="com.zarobitok.app"
            android:targetClass="com.zarobitok.app.MainActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="stop_shift"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_stop_short"
        android:shortcutLongLabel="@string/shortcut_stop_long">
        <intent
            android:action="com.zarobitok.action.STOP_SHIFT"
            android:targetPackage="com.zarobitok.app"
            android:targetClass="com.zarobitok.app.MainActivity" />
    </shortcut>

</shortcuts>
