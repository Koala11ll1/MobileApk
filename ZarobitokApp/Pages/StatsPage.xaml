<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZarobitokApp.Pages.StatsPage"
             Title="Статистика"
             BackgroundColor="#0B0B12">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label x:Name="MonthTitleLabel" FontSize="12" TextColor="#6B7280" Margin="4,8,0,0" />

            <Border BackgroundColor="#12121A" StrokeThickness="1" Stroke="#22FFFFFF" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label x:Name="MonthTotalLabel" FontSize="36" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" />
                    <Label x:Name="MonthNetLabel" FontSize="13" TextColor="#9CA3AF"
                           HorizontalOptions="Center" IsVisible="False" />

                    <ProgressBar x:Name="GoalProgress" Progress="0" ProgressColor="#4ADE80" Margin="0,10,0,0" />
                    <Label x:Name="GoalLabel" FontSize="13" TextColor="#9CA3AF" HorizontalOptions="Center" />

                    <Label x:Name="CompareLabel" FontSize="13" TextColor="#9CA3AF" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#12121A" StrokeThickness="1" Stroke="#22FFFFFF" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Середній заробіток за годину" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="PerHourLabel" Grid.Column="1" FontSize="14" FontAttributes="Bold" TextColor="#4ADE80" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Середній заробіток за зміну" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="PerShiftLabel" Grid.Column="1" FontSize="14" TextColor="White" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Середній за робочий день" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="PerDayLabel" Grid.Column="1" FontSize="14" TextColor="White" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#22FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Відпрацьовано" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="WorkedLabel" Grid.Column="1" FontSize="14" TextColor="White" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Змін / робочих днів" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="CountsLabel" Grid.Column="1" FontSize="14" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="ОСТАННІ 7 ДНІВ" FontSize="12" TextColor="#6B7280" Margin="4,8,0,0" />

            <Border BackgroundColor="#12121A" StrokeThickness="1" Stroke="#22FFFFFF" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Grid x:Name="ChartGrid" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" HeightRequest="150" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
