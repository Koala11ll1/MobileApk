<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ZarobitokApp.Localization"
             x:Class="ZarobitokApp.Pages.StatsPage"
             Title="{loc:T &quot;Статистика&quot;}"
             BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0,20,28" Spacing="18">

            <Label Text="{loc:T &quot;Статистика&quot;}" Style="{StaticResource PageTitle}" />


            <Label x:Name="MonthTitleLabel" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1" Stroke="{DynamicResource HairlineBrush}" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label x:Name="MonthTotalLabel" FontSize="36" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                    <Label x:Name="MonthNetLabel" FontSize="13" TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center" IsVisible="False" />

                    <ProgressBar x:Name="GoalProgress" Progress="0" ProgressColor="{DynamicResource Accent}" Margin="0,10,0,0" />
                    <Label x:Name="GoalLabel" FontSize="13" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" />

                    <Label x:Name="CompareLabel" FontSize="13" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1" Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Середній заробіток за годину&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="PerHourLabel" Grid.Column="1" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Середній заробіток за зміну&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="PerShiftLabel" Grid.Column="1" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Середній за робочий день&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="PerDayLabel" Grid.Column="1" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Відпрацьовано&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="WorkedLabel" Grid.Column="1" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Змін / робочих днів&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="CountsLabel" Grid.Column="1" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;ОСТАННІ 7 ДНІВ&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1" Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Grid x:Name="ChartGrid" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" HeightRequest="150" />
            </Border>

            <Button x:Name="ReportButton"
                    Text="{loc:T &quot;Звіт за період (PDF)&quot;}"
                    Clicked="OnReportClicked"
                    BackgroundColor="{DynamicResource Accent}"
                    TextColor="{DynamicResource AccentOn}"
                    FontAttributes="Bold" CornerRadius="14" HeightRequest="52"
                    Margin="0,4,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
