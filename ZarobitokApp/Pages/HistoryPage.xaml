<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZarobitokApp.Pages.HistoryPage"
             Title="Журнал"
             BackgroundColor="{DynamicResource Bg}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,20,20,0" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0"
                    x:Name="ListModeButton"
                    Text="Список"
                    Clicked="OnListModeClicked"
                    CornerRadius="12"
                    HeightRequest="42"
                    FontAttributes="Bold" />
            <Button Grid.Column="1"
                    x:Name="CalendarModeButton"
                    Text="Календар"
                    Clicked="OnCalendarModeClicked"
                    CornerRadius="12"
                    HeightRequest="42"
                    FontAttributes="Bold" />
            <Button Grid.Column="2"
                    Text="＋ Зміна"
                    Clicked="OnAddShiftClicked"
                    BackgroundColor="{DynamicResource Surface}"
                    TextColor="{DynamicResource Accent}"
                    CornerRadius="12"
                    HeightRequest="42"
                    FontAttributes="Bold" />
        </Grid>

        <Label Grid.Row="1"
               x:Name="HintLabel"
               Text="Тапни по зміні, щоб побачити деталі за день і виправити час. «＋ Зміна» додає пропущену зміну вручну. Помилкову можна видалити."
               FontSize="12"
               TextColor="{DynamicResource TextMuted}" />

        <CollectionView Grid.Row="2" x:Name="HistoryView" IsGrouped="True">
            <CollectionView.EmptyView>
                <Label Text="Поки порожньо"
                       TextColor="{DynamicResource TextFaint}"
                       HorizontalOptions="Center"
                       Margin="0,24" />
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="4,16,4,6" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding DayText}"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding TotalText}"
                               TextColor="{DynamicResource Accent}"
                               FontSize="13"
                               FontAttributes="Bold" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding TimeText}" TextColor="{DynamicResource TextPrimary}" FontSize="15" />
                            <Label Text="{Binding DetailText}" TextColor="{DynamicResource TextMuted}" FontSize="12" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="{Binding AmountText}"
                               TextColor="{DynamicResource Accent}"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalOptions="Center" />

                        <Button Grid.Column="2"
                                Text="✕"
                                FontSize="16"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource Surface}"
                                TextColor="{DynamicResource Danger}"
                                VerticalOptions="Center"
                                CommandParameter="{Binding .}"
                                Clicked="OnDeleteClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" x:Name="CalendarContainer" IsVisible="False" Spacing="14">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="‹"
                        Clicked="OnPrevMonthClicked"
                        BackgroundColor="{DynamicResource Surface}"
                        TextColor="{DynamicResource TextPrimary}"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        CornerRadius="12"
                        FontSize="18" />
                <Label Grid.Column="1"
                       x:Name="MonthLabel"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Button Grid.Column="2"
                        Text="›"
                        Clicked="OnNextMonthClicked"
                        BackgroundColor="{DynamicResource Surface}"
                        TextColor="{DynamicResource TextPrimary}"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        CornerRadius="12"
                        FontSize="18" />
            </Grid>

            <Label x:Name="MonthTotalLabel"
                   HorizontalOptions="Center"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Accent}" />

            <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,4,0,0">
                <Label Grid.Column="0" x:Name="Wd0" Text="Пн" HorizontalTextAlignment="Center" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                <Label Grid.Column="1" x:Name="Wd1" Text="Вт" HorizontalTextAlignment="Center" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                <Label Grid.Column="2" x:Name="Wd2" Text="Ср" HorizontalTextAlignment="Center" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                <Label Grid.Column="3" x:Name="Wd3" Text="Чт" HorizontalTextAlignment="Center" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                <Label Grid.Column="4" x:Name="Wd4" Text="Пт" HorizontalTextAlignment="Center" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                <Label Grid.Column="5" x:Name="Wd5" Text="Сб" HorizontalTextAlignment="Center" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                <Label Grid.Column="6" x:Name="Wd6" Text="Нд" HorizontalTextAlignment="Center" FontSize="11" TextColor="{DynamicResource TextMuted}" />
            </Grid>

            <CollectionView x:Name="CalendarView">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                      Span="7"
                                      HorizontalItemSpacing="4"
                                      VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding BackgroundColor}"
                                StrokeThickness="0"
                                HeightRequest="42"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCalendarDayTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DayText}"
                                   TextColor="{Binding TextColor}"
                                   FontAttributes="{Binding FontAttributes}"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

    </Grid>
</ContentPage>
