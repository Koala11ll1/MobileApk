<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ZarobitokApp.Localization"
             x:Class="ZarobitokApp.Pages.SettingsPage"
             Title="{loc:T &quot;Параметри&quot;}"
             BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0,20,28" Spacing="18">

            <Label Text="{loc:T &quot;Налаштування&quot;}" Style="{StaticResource PageTitle}" />


            <Label Text="{loc:T &quot;НАЛАШТУВАННЯ ЗМІНИ&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Ставка за годину&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="RateEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Валюта&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="CurrencyEntry"
                               Keyboard="Default"
                               MaxLength="4"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Планова тривалість, год&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="PlannedEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Неоплачувана перерва, хв&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="BreakEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;РОЗКЛАД СТАВОК&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Ставка у вихідні (сб, нд)&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="WeekendRateEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                        <Label Text="{loc:T &quot;Порожньо — така сама, як звичайна.&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Нічна ставка&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="NightRateEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                        <Label Text="{loc:T &quot;Порожньо — не використовується. Нічна перекриває вихідну.&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Ніч починається о (година 0–23)&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="NightStartEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Ніч закінчується о (година 0–23)&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="NightEndEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;ЦІЛЬ І ПОДАТКИ&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Ціль на місяць&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="GoalEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                        <Label Text="{loc:T &quot;0 або порожньо — без цілі.&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Податок / відрахування, %&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Entry x:Name="TaxEntry"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="{DynamicResource Surface}"
                               Completed="OnSettingsChanged"
                               Unfocused="OnSettingsChanged" />
                        <Label Text="{loc:T &quot;Показується «чиста» сума поруч із повною.&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;СПОВІЩЕННЯ&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:T &quot;Сповістити, коли зміна завершилась&quot;}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                            <Label Text="{loc:T &quot;По закінченню планової тривалості.&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="NotifyEndSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:T &quot;Щоденне нагадування почати зміну&quot;}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                            <Label Text="{loc:T &quot;Не показується, якщо зміна вже йде.&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="ReminderSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnToggled" />
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Час нагадування&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <TimePicker x:Name="ReminderPicker"
                                    Format="HH:mm"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BackgroundColor="{DynamicResource Surface}"
                                    PropertyChanged="OnReminderTimeChanged" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;ВИГЛЯД&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Тема&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Picker x:Name="ThemePicker"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource Surface}"
                                SelectedIndexChanged="OnAppearanceChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:T &quot;Мова&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Picker x:Name="LanguagePicker"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource Surface}"
                                SelectedIndexChanged="OnAppearanceChanged" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;ФОРМАТИ&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:T &quot;Тиждень починається з неділі&quot;}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>
                        <Switch x:Name="WeekSundaySwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:T &quot;12-годинний формат часу&quot;}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>
                        <Switch x:Name="Hour12Switch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnToggled" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;ЗАХИСТ&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:T &quot;PIN-код при вході&quot;}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                            <Label Text="{loc:T &quot;Також ховає суму зі скриншотів і зі списку недавніх застосунків.&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="PinSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnPinToggled" />
                    </Grid>

                    <Button x:Name="ChangePinButton"
                            Text="{loc:T &quot;Змінити PIN&quot;}"
                            Clicked="OnChangePinClicked"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextPrimary}"
                            CornerRadius="12" HeightRequest="48" />

                    <VerticalStackLayout x:Name="GraceBox" Spacing="4">
                        <Label Text="{loc:T &quot;Блокувати знову&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                        <Picker x:Name="GracePicker"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource Surface}"
                                SelectedIndexChanged="OnGraceChanged" />
                    </VerticalStackLayout>

                    <Grid x:Name="BiometricRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{loc:T &quot;Відбиток або обличчя&quot;}" FontSize="14" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                        <Switch x:Name="BiometricSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnBiometricToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:T &quot;Ховати суму у віджеті&quot;}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                            <Label Text="{loc:T &quot;На головному екрані замість суми буде «••••».&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="HideWidgetSwitch" Grid.Column="1" OnColor="{DynamicResource Accent}" Toggled="OnToggled" />
                    </Grid>

                    <Label Text="{loc:T &quot;Якщо забудете PIN, доступ можна відновити лише перевстановленням застосунку — дані зникнуть. Зробіть резервну копію. Сам PIN у копію не потрапляє.&quot;}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}" />

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;ДАНІ&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Button Text="{loc:T &quot;Експорт у CSV (Excel)&quot;}" Clicked="OnExportCsvClicked"
                            BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}"
                            CornerRadius="12" HeightRequest="48" />

                    <Button Text="{loc:T &quot;Зберегти резервну копію&quot;}" Clicked="OnBackupClicked"
                            BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}"
                            CornerRadius="12" HeightRequest="48" />

                    <Button Text="{loc:T &quot;Відновити з копії&quot;}" Clicked="OnRestoreClicked"
                            BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource Danger}"
                            CornerRadius="12" HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;ПРО ЗАСТОСУНОК&quot;}" FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Версія&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="VersionLabel" Grid.Column="1" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Button Text="{loc:T &quot;Нові версії на GitHub&quot;}"
                            Clicked="OnOpenReleasesClicked"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextPrimary}"
                            CornerRadius="12" HeightRequest="48" />

                    <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />

                    <Label x:Name="CrashLabel" FontSize="14" TextColor="{DynamicResource TextSecondary}" />

                    <Button x:Name="SendCrashButton"
                            Text="{loc:T &quot;Надіслати звіт про збої&quot;}"
                            Clicked="OnSendCrashesClicked"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextPrimary}"
                            CornerRadius="12" HeightRequest="48" />

                    <Button x:Name="ClearCrashButton"
                            Text="{loc:T &quot;Очистити звіти про збої&quot;}"
                            Clicked="OnClearCrashesClicked"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource Danger}"
                            CornerRadius="12" HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:T &quot;Зміни застосовуються одразу. Ставка перераховує всю поточну зміну, а не лише час після правки. По закінченню планової тривалості зміна завершується сама. Нічна ставка діє між зазначеними годинами за місцевим часом; зміна, що перетинає межу, рахується частинами.&quot;}"
                   FontSize="12"
                   TextColor="{DynamicResource TextMuted}"
                   Margin="4,0,4,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
