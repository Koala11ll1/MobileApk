<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZarobitokApp.Pages.ExtrasPage"
             Title="Допзаробіток"
             BackgroundColor="#0B0B12">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,20,20,0" RowSpacing="14">

        <Border Grid.Row="0"
                x:Name="FormCard"
                BackgroundColor="#12121A"
                StrokeThickness="1"
                Stroke="#22FFFFFF"
                Padding="16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">
                <Entry x:Name="LabelEntry"
                       Placeholder="Наприклад: продав ред бул"
                       PlaceholderColor="#6B7280"
                       TextColor="White"
                       BackgroundColor="#1C1C26" />
                <Entry x:Name="AmountEntry"
                       Placeholder="Сума"
                       Keyboard="Numeric"
                       PlaceholderColor="#6B7280"
                       TextColor="White"
                       BackgroundColor="#1C1C26" />
                <Button Text="Додати"
                        Clicked="OnAddClicked"
                        BackgroundColor="#4ADE80"
                        TextColor="#06210F"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="48" />
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="0"
               x:Name="NoShiftLabel"
               Text="Спочатку почніть зміну на вкладці «Зміна» — допзаробіток прив'язується до поточної зміни."
               FontSize="14"
               TextColor="#9CA3AF"
               IsVisible="False" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,0">
            <Label Text="ДОПЗАРОБІТОК ЦІЄЇ ЗМІНИ" FontSize="12" TextColor="#6B7280" />
            <Label Grid.Column="1" x:Name="ShiftExtrasTotalLabel"
                   FontSize="12" TextColor="#4ADE80" FontAttributes="Bold" />
        </Grid>

        <BoxView Grid.Row="2" HeightRequest="1" Color="#22FFFFFF" Margin="4,0" />

        <CollectionView Grid.Row="3" x:Name="ExtrasView">
            <CollectionView.EmptyView>
                <Label Text="Ще нічого не додано"
                       TextColor="#4B5563"
                       HorizontalOptions="Center"
                       Margin="0,24" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Label}" TextColor="White" FontSize="15" />
                            <Label Text="{Binding TimeText}" TextColor="#6B7280" FontSize="12" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="{Binding AmountText}"
                               TextColor="#4ADE80"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalOptions="Center" />

                        <Button Grid.Column="2"
                                Text="✕"
                                FontSize="16"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                CornerRadius="12"
                                BackgroundColor="#1C1C26"
                                TextColor="#F87171"
                                VerticalOptions="Center"
                                CommandParameter="{Binding .}"
                                Clicked="OnDeleteClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
