<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZarobitokApp.Pages.ShiftPage"
             Title="Зміна"
             BackgroundColor="#0B0B12">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- ЖИВИЙ ЛІЧИЛЬНИК -->
            <Border BackgroundColor="#12121A"
                    StrokeThickness="1"
                    Stroke="#22FFFFFF"
                    Padding="22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="AmountLabel"
                           Text="0.00"
                           FontSize="46"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />

                    <Label x:Name="PerSecondLabel"
                           FontSize="13"
                           TextColor="#6B7280"
                           HorizontalOptions="Center" />

                    <ProgressBar x:Name="ShiftProgress"
                                 Progress="0"
                                 ProgressColor="#4ADE80"
                                 Margin="0,10,0,4" />

                    <Label x:Name="ElapsedLabel"
                           FontSize="15"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="ToggleButton"
                    FontSize="17"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="16"
                    Clicked="OnToggleClicked" />

            <!-- ПОЧАТОК ЗМІНИ -->
            <Border BackgroundColor="#12121A" StrokeThickness="1"
                    Stroke="#22FFFFFF" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Початок зміни" FontSize="13" TextColor="#9CA3AF" />
                    <TimePicker x:Name="StartTimePicker"
                                Format="HH:mm"
                                FontSize="20"
                                TextColor="White"
                                BackgroundColor="#1C1C26"
                                PropertyChanged="OnStartTimeChanged" />
                    <Label x:Name="StartHintLabel"
                           FontSize="12"
                           TextColor="#6B7280" />
                </VerticalStackLayout>
            </Border>

            <!-- ДЕТАЛІ -->
            <Label Text="ДЕТАЛІ"
                   FontSize="12"
                   TextColor="#6B7280"
                   Margin="4,8,0,0" />

            <Border BackgroundColor="#12121A" StrokeThickness="1"
                    Stroke="#22FFFFFF" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Зароблено за цю зміну" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="ThisShiftLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold" TextColor="White" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Оплачуваний час" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="PaidTimeLabel" Grid.Column="1"
                               FontSize="14" TextColor="White" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="До плану лишилось" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="RemainingLabel" Grid.Column="1"
                               FontSize="14" TextColor="White" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#22FFFFFF" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Зароблено сьогодні" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="TodayLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold" TextColor="#4ADE80" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Завершених змін сьогодні" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="TodayCountLabel" Grid.Column="1"
                               FontSize="14" TextColor="White" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Відпрацьовано сьогодні" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="TodayHoursLabel" Grid.Column="1"
                               FontSize="14" TextColor="White" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#22FFFFFF" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Ставка" FontSize="14" TextColor="#9CA3AF" />
                        <Label x:Name="RateLabel" Grid.Column="1"
                               FontSize="14" TextColor="White" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
