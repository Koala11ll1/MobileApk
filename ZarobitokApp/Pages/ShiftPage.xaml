<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ZarobitokApp.Localization"
             x:Class="ZarobitokApp.Pages.ShiftPage"
             Title="{loc:T &quot;Зміна&quot;}"
             BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0,20,28" Spacing="18">

            <Label Text="{loc:T &quot;Зміна&quot;}" Style="{StaticResource PageTitle}" />


            <!-- ЖИВИЙ ЛІЧИЛЬНИК -->
            <Border BackgroundColor="{DynamicResource Card}"
                    StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}"
                    Padding="24,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="AmountLabel"
                           Text="0.00"
                           FontSize="56"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center" />

                    <Label x:Name="PerSecondLabel"
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center" />

                    <ProgressBar x:Name="ShiftProgress"
                                 Progress="0"
                                 ProgressColor="{DynamicResource Accent}"
                                 Margin="0,10,0,4" />

                    <Label x:Name="ElapsedLabel"
                           FontSize="15"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="ToggleButton"
                    FontSize="17"
                    FontAttributes="Bold"
                    HeightRequest="64"
                    CornerRadius="32"
                    Clicked="OnToggleClicked" />

            <!-- ПОЧАТОК ЗМІНИ -->
            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:T &quot;Початок зміни&quot;}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                    <TimePicker x:Name="StartTimePicker"
                                Format="HH:mm"
                                FontSize="20"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource Surface}"
                                PropertyChanged="OnStartTimeChanged" />
                    <Label x:Name="StartHintLabel"
                           FontSize="12"
                           TextColor="{DynamicResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <!-- ДЕТАЛІ -->
            <Label Text="{loc:T &quot;ДЕТАЛІ&quot;}"
                   FontSize="12"
                   TextColor="{DynamicResource TextMuted}"
                   Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Зароблено за цю зміну&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="ThisShiftLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Оплачуваний час&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="PaidTimeLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;До плану лишилось&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="RemainingLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Зароблено сьогодні&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    </Grid>

                    <Grid x:Name="TodayNetRow" ColumnDefinitions="*,Auto" IsVisible="False">
                        <Label Text="{loc:T &quot;Сьогодні після податку&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayNetLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Завершених змін сьогодні&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayCountLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Відпрацьовано сьогодні&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayHoursLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:T &quot;Ставка&quot;}" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="RateLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
