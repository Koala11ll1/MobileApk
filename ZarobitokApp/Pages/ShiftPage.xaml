<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZarobitokApp.Pages.ShiftPage"
             Title="Зміна"
             BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- ЖИВИЙ ЛІЧИЛЬНИК -->
            <Border BackgroundColor="{DynamicResource Card}"
                    StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}"
                    Padding="22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="AmountLabel"
                           Text="0.00"
                           FontSize="46"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center" />

                    <Label x:Name="PerSecondLabel"
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center" />

                    <ProgressBar x:Name="ShiftProgress"
                                 Progress="0"
                                 ProgressColor="{DynamicResource Accent}"
                                 Margin="0,10,0,4" />

                    <Label x:Name="ElapsedLabel"
                           FontSize="15"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="ToggleButton"
                    FontSize="17"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="16"
                    Clicked="OnToggleClicked" />

            <!-- ПОЧАТОК ЗМІНИ -->
            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Початок зміни" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                    <TimePicker x:Name="StartTimePicker"
                                Format="HH:mm"
                                FontSize="20"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource Surface}"
                                PropertyChanged="OnStartTimeChanged" />
                    <Label x:Name="StartHintLabel"
                           FontSize="12"
                           TextColor="{DynamicResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <!-- ДЕТАЛІ -->
            <Label Text="ДЕТАЛІ"
                   FontSize="12"
                   TextColor="{DynamicResource TextMuted}"
                   Margin="4,8,0,0" />

            <Border BackgroundColor="{DynamicResource Card}" StrokeThickness="1"
                    Stroke="{DynamicResource HairlineBrush}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Зароблено за цю зміну" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="ThisShiftLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Оплачуваний час" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="PaidTimeLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="До плану лишилось" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="RemainingLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Зароблено сьогодні" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                    </Grid>

                    <Grid x:Name="TodayNetRow" ColumnDefinitions="*,Auto" IsVisible="False">
                        <Label Text="Сьогодні після податку" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayNetLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Завершених змін сьогодні" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayCountLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Відпрацьовано сьогодні" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="TodayHoursLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource Hairline}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Ставка" FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="RateLabel" Grid.Column="1"
                               FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
